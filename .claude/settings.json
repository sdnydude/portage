{
  "permissions": {
    "allow": [
      "Bash(~/.claude/scripts/post-insight.sh *)",
      "Bash(~/.claude/scripts/post-decision-logs.sh *)",
      "Bash(doppler secrets *)",
      "Bash(doppler projects *)",
      "Bash(docker logs *)",
      "Bash(git worktree *)",
      "Bash(cloudflared tunnel *)",
      "Bash(systemctl status *)",
      "Bash(systemctl is-active *)",
      "Bash(crontab -l)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run test:api)",
      "Bash(npm run build *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/swebber64/DHG/portage/.claude/hooks/doppler-sync.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash /home/swebber64/DHG/portage/.claude/hooks/session-briefing.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/swebber64/DHG/portage/.claude/hooks/memory-sync.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash /home/swebber64/DHG/portage/.claude/hooks/session-capture.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/swebber64/DHG/portage/.claude/hooks/commit-log.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/swebber64/DHG/portage/.claude/hooks/check-ports.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/swebber64/DHG/portage/.claude/hooks/enforce-ship.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
