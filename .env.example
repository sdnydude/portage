# Database
DATABASE_URL=postgresql://portage:portage@10.0.0.251:5436/portage

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars
ENCRYPTION_KEY=your-64-char-hex-encryption-key

# Cloudflare Access (identity layer — CF is the IdP, no local passwords)
CF_ACCESS_TEAM_DOMAIN=digitalharmonyai
CF_ACCESS_AUD=access-app-audience-tag
# Dev-only identity when no CF edge is in front (NODE_ENV=development only)
CF_ACCESS_DEV_EMAIL=
# User identity for CF Access service-token requests (e2e). BOTH must be set
# and the token's common_name must equal CF_ACCESS_SERVICE_COMMON_NAME.
CF_ACCESS_SERVICE_EMAIL=
CF_ACCESS_SERVICE_COMMON_NAME=

# DHG Registry (LAN-internal) — beta tester reports are proxied here
REGISTRY_URL=http://10.0.0.251:8011

# Beta invite emails (Resend). RESEND_FROM must be on a verified Resend domain.
RESEND_API_KEY=
RESEND_FROM="Portage Beta <beta@beta.digitalharmonyai.com>"
# Public app URL for emails/links. Define ONCE — dotenv is first-definition-wins, a later duplicate is silently ignored.
APP_URL=https://portage.digitalharmonyai.com

# Cloudflare API for the admin allowlist manager (token needs Access:Edit)
CF_API_TOKEN=
CF_ACCOUNT_ID=
# Access application IDs carrying the allow policy (web app, API hostname app)
CF_ACCESS_APP_IDS=

# AI Provider Chains (comma-separated, tried in order: local, gemini, openai, huggingface, anthropic)
# Entry syntax: provider[:model][@reasoning_effort]. "@effort" overrides the provider default
# ('none' for gemini) — gemini-3.5-flash-lite rejects 'none' and needs 'minimal'.
# Approved 2026-09-05 chain (live probe: Lite 10/10 ident, p50 2.8s):
VISION_PROVIDERS=gemini:gemini-3.5-flash-lite@minimal,gemini:gemini-3.8-flash,anthropic:claude-haiku-4-5
CHAT_PROVIDERS=local,gemini,anthropic

# Local LLM (Ollama, vLLM, llama.cpp, etc.)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_VISION_MODEL=qwen3-vl
LOCAL_LLM_CHAT_MODEL=qwen3:8b

# Google Gemini (uses OpenAI-compatible endpoint)
GEMINI_API_KEY=your-google-ai-key
GEMINI_VISION_MODEL=gemini-2.5-pro
GEMINI_CHAT_MODEL=gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_VISION_MODEL=gpt-4.1
OPENAI_CHAT_MODEL=gpt-4o-mini

# HuggingFace Inference (routes to DeepInfra, Together, etc.)
HUGGINGFACE_API_KEY=hf_...
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
HUGGINGFACE_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Anthropic (fallback)
ANTHROPIC_API_KEY=sk-ant-...

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=portage-images
R2_PUBLIC_URL=https://your-r2-public-url

# eBay
EBAY_CLIENT_ID=your-client-id
EBAY_CLIENT_SECRET=your-client-secret
# Production keyset (used when EBAY_SANDBOX=false; falls back to EBAY_CLIENT_ID/SECRET if unset)
EBAY_PROD_CLIENT_ID=
EBAY_PROD_CLIENT_SECRET=
EBAY_REDIRECT_URI=https://portage.digitalharmonyai.com/auth/ebay/callback
EBAY_SANDBOX=true
# Marketplace Account Deletion notifications (compliance-mandatory, PUBLIC endpoint).
# TOKEN: 32-80 chars [A-Za-z0-9_-]; URL: the exact string registered in the eBay
# developer portal (both feed the challenge hash). Required in production.
EBAY_DELETION_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT_URL=https://portage-api.digitalharmonyai.com/marketplace/ebay/account-deletion

# Reverb (legacy global PAT — per-user tokens pasted in Settings are the shipped auth flow)
REVERB_API_TOKEN=

# Stripe (run setup-stripe-products.ts to generate price IDs)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
STRIPE_PRICE_CREDITS=price_...

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-public-key
VAPID_PRIVATE_KEY=your-private-key
VAPID_EMAIL=mailto:support@portageai.com

# Metrics (if set, GET /metrics requires Authorization: Bearer <secret>)
METRICS_SECRET=

# Langfuse LLM tracing. Both keys must be set or tracing stays off entirely.
# Keys: Langfuse project > Settings > API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Fraction of traces exported, 0..1 (default 1 = all).
LANGFUSE_SAMPLE_RATE=1

# App
NODE_ENV=development
API_PORT=8016
WEB_PORT=3002
